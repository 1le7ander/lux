# LUXE Environment Configuration
# Copy this file to .env.local and fill in your values

# Firebase
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# EmailJS
VITE_EMAILJS_SERVICE_ID=service_XXXXXXX
VITE_EMAILJS_TEMPLATE_ID=template_XXXXXXX
VITE_EMAILJS_PUBLIC_KEY=XXXXXXXXXXXXXXX
VITE_EMAILJS_TO=your_email@example.com

# Google Sheets
VITE_APPS_SCRIPT_URL=your_apps_script_webapp_url

# Admin Credentials (SHA-256 hashes)
VITE_ADMIN_USER_HASH=your_sha256_username_hash
VITE_ADMIN_PASS_HASH=your_sha256_password_hash

