# Google Apps Script web app URL (deploy Code.gs in google-apps-script/ as a Web App)
APPS_SCRIPT_URL="https://script.google.com/macros/s/DEPLOYMENT_ID/exec"

# Shared secret between the Next.js API routes and the Apps Script endpoint.
# MUST match the `KEY` constant inside google-apps-script/Code.gs
ADMIN_KEY="agency2025admin"

# SHA-256 hashes of the admin username and password. Generate with:
#   node -e 'console.log(require("crypto").createHash("sha256").update("YOUR_VALUE").digest("hex"))'
# Defaults below are the hashes of:
#   user: LUXE
#   pass: Lux999@@009
ADMIN_USER_HASH="4e1243bd22c66e76c2ba9eddc1f91394e57f9f83b017343e7e09a2e58d7e6d94"
ADMIN_PASS_HASH="placeholder_replace_with_sha256_of_real_password"

# Google Drive folder that receives uploaded product images.
# This is referenced from Code.gs as DRIVE_FOLDER_ID.
DRIVE_FOLDER_ID="1viIogXrZm2dpdf3kKO-ohrO_2Ejsgss6"

