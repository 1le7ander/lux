# Copy this file to .env.local and fill in real secrets below.
# Real secrets must NEVER be committed back to .env.example — it is tracked in git.

# Google Apps Script web app URL (deploy Code.gs in google-apps-script/ as a Web App)
APPS_SCRIPT_URL="https://script.google.com/macros/s/DEPLOYMENT_ID/exec"

# Shared secret between the Next.js API routes and the Apps Script endpoint.
# MUST match the value stored in the Apps Script "ADMIN_KEY" script property
# (see google-apps-script/README.md). Generate a strong random value, e.g.:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
ADMIN_KEY="change-me-to-a-random-secret"

# SHA-256 hashes of the admin username and password. Generate with:
#   node -e 'console.log(require("crypto").createHash("sha256").update("YOUR_VALUE").digest("hex"))'
# Leaving these empty disables admin login entirely (no session will be accepted).
ADMIN_USER_HASH="<sha256-of-your-admin-username>"
ADMIN_PASS_HASH="<sha256-of-your-admin-password>"

# Google Drive folder that receives uploaded product images (resource id, not secret).
DRIVE_FOLDER_ID="1viIogXrZm2dpdf3kKO-ohrO_2Ejsgss6"

# Google Sheets database for products + orders (resource id, not secret).
SHEETS_ID="1mkPF4ObtuS3wmjLjmG5UE18lq6dpW_1LWuT15r08dM0"

# Store-wide public config (these ship to the client bundle — do not put secrets here)
NEXT_PUBLIC_SITE_NAME="LUXE"
NEXT_PUBLIC_WHATSAPP_NUMBER="213555000000"
NEXT_PUBLIC_EMAIL="heamtan126@gmail.com"
